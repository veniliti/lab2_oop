<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FacultyArchiveXml.Models"
             x:Class="FacultyArchiveXml.Views.MaterialsView"
             Title="Електронний архів факультету (XML)">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="12" RowSpacing="8">

        
        <FlexLayout Grid.Row="0" Wrap="Wrap" AlignItems="Center">
            <Button Text="Обрати XML-файл" Clicked="OnSelectFileClicked" Margin="0,0,8,6"/>
            <Label x:Name="FileLabel" Text="Файл не обрано" VerticalOptions="Center"
                   LineBreakMode="MiddleTruncation"/>
        </FlexLayout>

      
        <FlexLayout Grid.Row="1" Wrap="Wrap" AlignItems="Center">
            <Label Text="Спосіб пошуку:" VerticalOptions="Center" Margin="0,0,8,0"/>
            <Picker x:Name="StrategyPicker" Title="SAX / DOM / LINQ" WidthRequest="200"
                    SelectedIndexChanged="OnStrategySelected"/>
        </FlexLayout>

        
        <FlexLayout Grid.Row="2" Wrap="Wrap" AlignItems="Center">
            <Picker x:Name="AttributePicker" Title="Атрибут" WidthRequest="200" Margin="0,0,8,0"
                    SelectedIndexChanged="OnAttributeSelected"/>
            <Picker x:Name="ValuePicker" Title="Значення з файлу" WidthRequest="260" Margin="0,0,8,0"/>
            <Entry x:Name="KeywordEntry" Placeholder="або ключове слово" WidthRequest="220"/>
        </FlexLayout>

        
        <FlexLayout Grid.Row="3" Wrap="Wrap">
            <Button Text="Пошук" Clicked="OnSearchClicked" Margin="0,0,6,6"/>
            <Button Text="Трансформувати в HTML" Clicked="OnTransformClicked" Margin="0,0,6,6"/>
            <Button Text="Clear" Clicked="OnClearClicked" Margin="0,0,6,6"/>
            <Button Text="Вихід" Clicked="OnExitClicked" Margin="0,0,6,6"/>
        </FlexLayout>

        <Label Grid.Row="4" x:Name="CountLabel" FontAttributes="Bold"/>

       
        <Grid Grid.Row="5" ColumnDefinitions="2*,3*,2*,2*,1.5*,*,1.5*" ColumnSpacing="6" Padding="8,6"
              BackgroundColor="{AppThemeBinding Light=#DDDDDD, Dark=#3A3A3A}">
            <Label Grid.Column="0" Text="П.І.П. автора" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="Назва" FontAttributes="Bold"/>
            <Label Grid.Column="2" Text="Факультет" FontAttributes="Bold"/>
            <Label Grid.Column="3" Text="Кафедра" FontAttributes="Bold"/>
            <Label Grid.Column="4" Text="Вид" FontAttributes="Bold"/>
            <Label Grid.Column="5" Text="Обсяг" FontAttributes="Bold"/>
            <Label Grid.Column="6" Text="Дата" FontAttributes="Bold"/>
        </Grid>

       
        <CollectionView Grid.Row="6" x:Name="ResultsView" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Material">
                    <Grid ColumnDefinitions="2*,3*,2*,2*,1.5*,*,1.5*" ColumnSpacing="6" Padding="8,8">
                        <Label Grid.Column="0" Text="{Binding AuthorFullName}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="1" Text="{Binding Title}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="2" Text="{Binding Faculty}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="3" Text="{Binding Department}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="4" Text="{Binding MaterialType}"/>
                        <Label Grid.Column="5" Text="{Binding Volume}"/>
                        <Label Grid.Column="6" Text="{Binding CreationDate}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
